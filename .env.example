# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=uptime_user
POSTGRES_PASSWORD=uptime_secret
POSTGRES_DB=uptime_monitor
DATABASE_URL=postgresql://uptime_user:uptime_secret@localhost:5432/uptime_monitor?schema=public

# Authentication
JWT_SECRET=pulseledger_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Background Worker
WORKER_CONCURRENCY=20
WORKER_TICK_MS=10000

# Client Configuration
VITE_API_BASE_URL=http://localhost:4000/api
