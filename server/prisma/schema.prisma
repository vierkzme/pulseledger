generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HttpMethod {
  GET
  POST
  PUT
  HEAD
  DELETE
}

enum MonitorStatus {
  PENDING
  UP
  DOWN
  PAUSED
}

enum PingStatus {
  UP
  DOWN
}

enum IncidentStatus {
  ONGOING
  RESOLVED
}

enum ChannelType {
  DISCORD
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique @db.VarChar(255)
  passwordHash         String                @map("password_hash")
  name                 String                @db.VarChar(100)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  monitors             Monitor[]
  notificationChannels NotificationChannel[]

  @@map("users")
}

model Monitor {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  name              String                @db.VarChar(100)
  url               String                @db.Text
  method            HttpMethod            @default(GET)
  headers           Json?                 @default("{}")
  body              String?               @db.Text
  intervalSeconds   Int                   @default(60) @map("interval_seconds")
  timeoutMs         Int                   @default(10000) @map("timeout_ms")
  expectedStatusMin Int                   @default(200) @map("expected_status_min")
  expectedStatusMax Int                   @default(299) @map("expected_status_max")
  isActive          Boolean               @default(true) @map("is_active")
  currentStatus     MonitorStatus         @default(PENDING) @map("current_status")
  lastLatencyMs     Int?                  @map("last_latency_ms")
  lastCheckedAt     DateTime?             @map("last_checked_at")
  nextCheckAt       DateTime              @default(now()) @map("next_check_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pingLogs      PingLog[]
  incidents     Incident[]
  notifications MonitorNotification[]

  @@index([isActive, nextCheckAt], name: "idx_monitors_scheduler")
  @@index([userId], name: "idx_monitors_user")
  @@map("monitors")
}

model PingLog {
  id           BigInt     @id @default(autoincrement())
  monitorId    String     @map("monitor_id") @db.Uuid
  status       PingStatus
  statusCode   Int?       @map("status_code")
  latencyMs    Int        @map("latency_ms")
  errorMessage String?    @map("error_message") @db.VarChar(500)
  checkedAt    DateTime   @default(now()) @map("checked_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)], name: "idx_ping_logs_monitor_time")
  @@index([checkedAt], name: "idx_ping_logs_cleanup")
  @@map("ping_logs")
}

model Incident {
  id              String         @id @default(uuid()) @db.Uuid
  monitorId       String         @map("monitor_id") @db.Uuid
  status          IncidentStatus @default(ONGOING)
  cause           String         @db.VarChar(500)
  startedAt       DateTime       @default(now()) @map("started_at")
  resolvedAt      DateTime?      @map("resolved_at")
  durationSeconds Int?           @map("duration_seconds")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, startedAt(sort: Desc)], name: "idx_incidents_monitor")
  @@map("incidents")
}

model NotificationChannel {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  name       String      @db.VarChar(100)
  type       ChannelType @default(DISCORD)
  webhookUrl String      @map("webhook_url") @db.Text
  isEnabled  Boolean     @default(true) @map("is_enabled")
  createdAt  DateTime    @default(now()) @map("created_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors MonitorNotification[]

  @@index([userId])
  @@map("notification_channels")
}

model MonitorNotification {
  monitorId String @map("monitor_id") @db.Uuid
  channelId String @map("channel_id") @db.Uuid

  monitor Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([monitorId, channelId])
  @@map("monitor_notifications")
}
